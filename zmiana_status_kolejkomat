function main(workbook: ExcelScript.Workbook) {

    const tableName = "SYS_ProcesKolejkomat";
    const newStatus = "aktualizacja_logistyka";

    // Pobranie tabeli głównej
    const table = workbook.getTable(tableName);

    if (!table) {
        throw new Error(`Tabela ${tableName} nie istnieje`);
    }

    const dataRange = table.getRangeBetweenHeaderAndTotal();
    const values = dataRange.getValues();

    const idxStatus = table.getColumnByName("Status").getIndex();

    if (values.length === 0) return;

    // Aktualizacja statusów
    for (let i = 0; i < values.length; i++) {
        values[i][idxStatus] = newStatus;
    }

    dataRange.setValues(values);


    // =========================
    // TABELA 'takt' — update 1. wiersza
    // =========================

    const taktTable = workbook.getTable("takt");

    if (!taktTable) {
        throw new Error(`Tabela takt nie istnieje`);
    }

    const taktRange = taktTable.getRangeBetweenHeaderAndTotal();
    const taktValues = taktRange.getValues();

    if (taktValues.length > 0) {

        const idxAktualizacja = taktTable.getColumnByName("aktualizacja").getIndex();

        // pierwszy wiersz, kolumna "aktualizacja"
        taktValues[0][idxAktualizacja] = "trwa";

        taktRange.setValues(taktValues);
    }

}
